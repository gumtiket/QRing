#!/bin/bash
# 코드 받기 → 시크릿 조립 → systemd 서비스 등록/시작.
set -euo pipefail

INSTALL_DIR="/opt/qring"

dnf install -y nodejs unzip jq

# SSM 세션 관리자 접속용. AL2023 기본 저장소 버전이 오래돼 세션 채널이 안 붙는 문제가
# 있어서, AWS가 배포하는 최신 빌드를 직접 설치한다.
dnf remove -y amazon-ssm-agent || true
dnf install -y "https://s3.${aws_region}.amazonaws.com/amazon-ssm-${aws_region}/latest/linux_amd64/amazon-ssm-agent.rpm"
systemctl enable --now amazon-ssm-agent

mkdir -p "$INSTALL_DIR"
cd "$INSTALL_DIR"

# 배포 아티팩트 받기 (infra/scripts/deploy.sh가 올려둔 최신본)
aws s3 cp "s3://${deploy_bucket}/latest.zip" ./app.zip --region "${aws_region}"
unzip -o -q app.zip
rm -f app.zip

# RDS 서버 인증서를 검증할 CA 번들. RDS는 자체 CA로 서명한 인증서를 쓰기 때문에 OS 기본 신뢰
# 저장소로는 검증이 안 되고, 이 파일을 받아서 앱에 알려줘야 한다(DATABASE_SSL_CA).
curl -fsSL -o "$INSTALL_DIR/rds-ca.pem" \
  "https://truststore.pki.rds.amazonaws.com/${aws_region}/${aws_region}-bundle.pem"

# RDS 마스터 암호(Secrets Manager) 조립
DB_SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "${rds_secret_arn}" --region "${aws_region}" --query SecretString --output text)

# 암호를 퍼센트 인코딩해서 URL에 넣는다. systemd의 EnvironmentFile 파서는 값 안의 #를 주석
# 시작으로 보고 그 뒤를 잘라내는데, RDS가 생성한 암호에 #가 섞여서 DATABASE_URL이 잘리고
# 호스트를 못 찾는 사고가 실제로 났다. 인코딩하면 #·공백·"·/·@가 전부 %XX가 되어 안전하고,
# pg(pg-connection-string)가 URL에서 알아서 되돌려 읽는다.
DB_PASSWORD=$(echo "$DB_SECRET_JSON" | jq -r '.password | @uri')

# VAPID 키(SSM)
VAPID_PUBLIC_KEY=$(aws ssm get-parameter --name "/qring/vapid-public-key" --region "${aws_region}" --query Parameter.Value --output text)
VAPID_PRIVATE_KEY=$(aws ssm get-parameter --name "/qring/vapid-private-key" --with-decryption --region "${aws_region}" --query Parameter.Value --output text)
VAPID_SUBJECT=$(aws ssm get-parameter --name "/qring/vapid-subject" --region "${aws_region}" --query Parameter.Value --output text)

cat > "$INSTALL_DIR/.env" <<ENVEOF
PORT=${port}
BASE_URL=${base_url}
AWS_REGION=${aws_region}
DATABASE_URL=postgresql://${db_username}:$DB_PASSWORD@${db_host}:${db_port}/${db_name}
DATABASE_SSL_CA=$INSTALL_DIR/rds-ca.pem
WEBPUSH_DISPATCH_QUEUE_ARN=${webpush_queue_arn}
WEBPUSH_DISPATCH_QUEUE_URL=${webpush_queue_url}
VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
VAPID_SUBJECT=$VAPID_SUBJECT
ENVEOF
chmod 600 "$INSTALL_DIR/.env"
chown ec2-user:ec2-user "$INSTALL_DIR/.env"

# 앱보다 먼저 스키마를 맞춘다. 웹 2대 + 워커 1대가 동시에 부팅해도 migrate.js가 자문 락으로
# 직렬화하므로, 셋 다 이 유닛을 돌려도 안전하다.
# RemainAfterExit=yes라야 끝난 뒤에도 active로 남아 아래 Requires=가 만족된다.
cat > "/etc/systemd/system/qring-migrate.service" <<MIGRATEEOF
[Unit]
Description=QRing DB migration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$INSTALL_DIR
EnvironmentFile=$INSTALL_DIR/.env
ExecStart=/usr/bin/node dist/db/migrate.js
User=ec2-user
MIGRATEEOF

# Requires= 라서 마이그레이션이 실패하면 앱은 아예 뜨지 않는다.
# 깨진 스키마 위에서 도는 것보다 안 뜨는 게 낫다.
cat > "/etc/systemd/system/qring-${role}.service" <<UNITEOF
[Unit]
Description=QRing ${role}
After=network.target qring-migrate.service
Requires=qring-migrate.service

[Service]
Type=simple
WorkingDirectory=$INSTALL_DIR
EnvironmentFile=$INSTALL_DIR/.env
ExecStart=/usr/bin/node ${entry_point}
Restart=always
RestartSec=5
User=ec2-user

[Install]
WantedBy=multi-user.target
UNITEOF

systemctl daemon-reload
systemctl enable "qring-${role}"
systemctl start "qring-${role}"
